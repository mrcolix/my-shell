# =============================================================================
#  zsh configuration -- generated by my-shell
# =============================================================================
#  This template is only used when no .zshrc exists. If one is already there,
#  my-shell never overwrites it: it appends a clearly delimited managed block
#  at the end instead. Look for the my-shell markers to find it.
# =============================================================================

# Do nothing when this file is sourced by a non-interactive shell.
[[ -o interactive ]] || return

# --- Powerlevel10k instant prompt -------------------------------------------
# Must stay close to the top of the file: anything above it that needs console
# input (password prompts, [y/n] questions) will be swallowed.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

ZSH_THEME="powerlevel10k/powerlevel10k"

# No magic git functions: they rewrite the widget behaviour of common
# shortcuts. Comment this out if you want them back.
DISABLE_MAGIC_FUNCTIONS="true"

# Show a red dot while completion is running.
COMPLETION_WAITING_DOTS="true"

# Extra plugins are loaded from the my-shell managed block at the end of this
# file, not from here: sourcing them explicitly keeps the load order under our
# control (zsh-syntax-highlighting has to come last) and makes this file work
# on distributions that ship Oh My Zsh from a package.
plugins=(
  git
)

source $ZSH/oh-my-zsh.sh

# --- Powerlevel10k configuration --------------------------------------------
# Shipped by my-shell; regenerate it any time with `p10k configure`.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

