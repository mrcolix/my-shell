" =============================================================================
"  vim configuration -- generated by my-shell
" =============================================================================
"  Only installed when ~/.vimrc does not exist yet. An existing ~/.vimrc is
"  never overwritten: my-shell offers keep / backup / merge / cancel instead.
" =============================================================================

" If you are running vim in a terminal that does not support colours, or you
" just do not want them:
"   set t_Co=0
set t_Co=256

" --- General ----------------------------------------------------------------
set nocompatible              " use vim defaults, not vi
set encoding=utf-8
set fileencoding=utf-8
set backspace=indent,eol,start  " make backspace behave in insert mode
set hidden                    " keep modified buffers when switching files
set undofile                  " persist the undo tree between sessions

" --- Display ----------------------------------------------------------------
syntax on
set number                    " line numbers
set relativenumber            " relative numbers, absolute on the cursor line
set ruler                     " show the cursor position at all times
set showcmd                   " show the partially typed command
set laststatus=2              " always show the status bar
set scrolloff=3               " keep some context above and below the cursor
set sidescrolloff=5
set shortmess+=I              " do not beep on every message
set cursorline                " highlight the current line
set fillchars=eob:\ ,stl:\ ,stlnc:\ " nicer status line separators

" --- Indentation ------------------------------------------------------------
set autoindent
set smartindent
set expandtab                 " spaces, not tabs
set tabstop=4
set shiftwidth=4
set softtabstop=4
set shiftround                " shiftwidth is used for reindenting, not the
                              " tabstop
set autoindent+=10            " also apply to cstyle and friends
set formatoptions-=c formatoptions-=r formatoptions-=o  " do not comment
                                                            " wrapped lines
set comments=b:*,:*,:_,:#

" --- Search -----------------------------------------------------------------
set hlsearch                  " highlight all matches, not just the current one
set incsearch                 " show the match while typing the pattern
set ignorecase                " case insensitive searching
set smartcase                 " ...unless the pattern has a capital letter
set wrapscan                  " wrap around when searching past the end

" --- Behaviour --------------------------------------------------------------
set confirm                    " prompt before discarding a modified buffer
set autowrite                  " write on :chdir and on close
set updatetime=300
set timeoutlen=500             " mappings resolve quickly
set whichwrap=b,s,<,>,[,]      " make h/j/k/l work at the edges of the file
set history=1000

" --- Split windows ----------------------------------------------------------
set splitbelow
set splitright
set equalalways                " keep the splits the same size
set splitbelow
set laststatus=2

" --- Completeness -----------------------------------------------------------
" Matching is case insensitive and the threshold is low, which feels right for
" most projects.
set wildmenu                   " a menu at the bottom of the screen
set wildmode=longest:full,full
set wildignorecase
set wildignore+=*.o,*.obj,*.a,*.so,*.swp,*.class
set completeopt=menuone,noinsert,noselect
set path+=**                   " every subdirectory is on the 'path'

" --- Colours ----------------------------------------------------------------
if has('gui_running') || &termguicolors
  set termguicolors
endif

" Keep a readable status line in reverse video.
highlight StatusLine   ctermbg=NONE   ctermfg=Bold   termbg=NONE   termfg=Bold
highlight StatusLineNC ctermbg=NONE   ctermfg=Normal termbg=NONE   termfg=Normal

" A neutral 256-colour scheme: visible on both light and dark terminals without
" depending on a plugin that may not be installed.
if &t_Co > 88
  colorscheme ron
  highlight Normal        guibg=NONE
  highlight Comment       ctermfg=244   guifg=#757575
  highlight Constant      ctermfg=168   guifg=#af87ff
  highlight Identifier    ctermfg=252   guifg=#eeeeec
  highlight Statement     ctermfg=81    guifg=#8ae234
  highlight PreProc       ctermfg=204   guifg=#f92672
  highlight Type          ctermfg=23    guifg=#66d9ef italic
  highlight String        ctermfg=114   guifg=#e6db74
  highlight Special       ctermfg=168   guifg=#af87ff
  highlight Todo          ctermbg=23    ctermfg=White
  highlight Error         ctermfg=232   ctermbg=203
  highlight Search        ctermbg=230   ctermfg=0
  highlight MatchParen    ctermfg=28    ctermbg=236
  highlight CursorLine    ctermbg=236   cterm=NONE
  highlight CursorColumn  ctermbg=236
  highlight LineNr        ctermfg=240
  highlight CursorLineNr  ctermfg=252   cterm=bold
  highlight StatusLine    ctermfg=252
  highlight StatusLineNC  ctermfg=240
  highlight SignColumn    ctermfg=240
  highlight VertSplit     ctermfg=240
else
  highlight Normal        ctermbg=LightGrey ctermfg=DarkBlue
  highlight Error         ctermbg=DarkRed   ctermfg=White
  highlight Search        ctermbg=Black     ctermfg=Yellow
  highlight MatchParen    ctermbg=Yellow   ctermfg=Black
  highlight CursorLine    cterm=bold  ctermbg=White
  highlight StatusLine    ctermbg=LightGrey ctermfg=DarkBlue
  highlight StatusLineNC  ctermbg=LightGrey ctermfg=DarkBlue
endif
